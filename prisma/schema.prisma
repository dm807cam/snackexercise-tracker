// Snack Exercise Tracker — data model.
//
// The unit of logging is a SetEntry: one thing you picked up and moved, at a
// point in time. There is deliberately no "workout" or "session" entity — the
// whole premise is that training happens in scattered snacks, not sessions.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Exercise {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  category  String  @default("other")
  /// True for movements normally done without external load (push-ups, pull-ups).
  /// Lets the UI stop nagging for a weight that was never going to exist.
  bodyweight Boolean @default(false)
  isCustom  Boolean @default(false)
  archived  Boolean @default(false)

  /// How much of this movement is aerobic, 0..1. 0 is pure resistance work,
  /// 1 is pure cardio, and the middle is where the honest answers live —
  /// kettlebell swings, burpees, sled pushes. A set splits by this fraction:
  /// (1 - cardioBias) of its effective sets count as strength, cardioBias of
  /// its MET-minutes count as cardio. Nothing is counted twice.
  cardioBias Float @default(0)
  /// Default metabolic cost in METs, from the Compendium of Physical
  /// Activities. Only consulted when neither heart rate nor pace is known.
  mets       Float?

  muscles ExerciseMuscle[]
  entries SetEntry[]

  createdAt DateTime @default(now())
}

/// How much a single set of an exercise counts toward each muscle.
/// weight: 1.0 primary mover, 0.5 secondary, 0.25 stabiliser.
model ExerciseMuscle {
  exerciseId String
  muscle     String
  weight     Float

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscle])
  @@index([muscle])
}

model SetEntry {
  id String @id @default(cuid())

  /// Full timestamp, used for chronological ordering within a day.
  performedAt DateTime
  /// "YYYY-MM-DD" in the configured local timezone. Denormalised so that every
  /// day/calendar/window query is an index scan with no timezone arithmetic.
  localDate   String

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  sets        Int    @default(1)
  reps        Int?
  weightKg    Float?
  durationSec Int?
  /// Metres covered, for movements that go somewhere. With durationSec this
  /// yields a pace, and a pace yields METs without the user rating anything.
  distanceM   Float?
  /// Mean heart rate in bpm, if a watch recorded one. Best available evidence
  /// of intensity; everything else is inference.
  avgHeartRate Int?
  /// "easy" | "hard" | "failure" — how close the set was to failure, which is
  /// the variable that gates hypertrophic stimulus. Null means the user did not
  /// say, which is every row logged before this column existed; lib/effort.ts
  /// decides what that is worth and says why.
  effort      String?
  notes       String?

  /// "manual" | "llm" — lets you see which entries came from dictation.
  source String @default("manual")

  createdAt DateTime @default(now())

  @@index([localDate])
  @@index([performedAt])
  @@index([exerciseId])
}

/// One row per local day: things that are true *of the day* rather than
/// things you did at a moment. Steps arrive from a phone after the fact, with
/// no time, no exercise and no muscle mapping, so they are not SetEntry rows —
/// forced in there they would inflate entry counts, set counts, active days
/// and the calendar shading, and every existing query would quietly start
/// lying. Keyed on the same "YYYY-MM-DD" every other query already uses, so
/// joining a day, a window or a calendar grid costs one index lookup.
model DailyMetric {
  localDate String @id
  steps     Int?

  /// "manual" | "shortcut" | "import" — worth knowing whether a number was
  /// typed or came from a phone automation.
  source    String   @default("manual")
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}
