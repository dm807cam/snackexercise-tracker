# Every variable is optional. The container starts with none of them set and
# does the sensible thing for one box on a home network; each one below exists
# because some deployment needs it. The README's "Running it" section says when.

# --- Basics -----------------------------------------------------------------

# Host port the app is published on. The container always listens on 3000.
APP_PORT="3000"

# Local SQLite database file. In Docker this points at the mounted volume.
DATABASE_URL="file:./dev.db"

# The zone a new account starts in; each person can change their own in Settings.
TZ="Europe/Berlin"

# --- Reaching it ------------------------------------------------------------

# The address people use, e.g. https://snacks.example.com. Used for invitation
# and reset links, the push-notification contact, and the origin that
# state-changing requests must come from. Unset: whatever Host it is reached by.
# APP_URL=""

# How many reverse proxies sit in front (decides which X-Forwarded-For entry is
# the client). 0 when the app is reached directly and nothing strips the header.
# TRUST_PROXY="1"

# Force the Secure flag on the sign-in cookie on or off. Default: on whenever
# the request came over HTTPS, and always when APP_URL is https.
# COOKIE_SECURE=""

# --- Accounts ---------------------------------------------------------------

# An unattended first boot: create the first admin from these, once. Remove
# ADMIN_PASSWORD afterwards; it is not read again.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""

# If set, /setup asks for it, so whoever reaches a fresh instance first cannot
# make themselves its admin.
# SETUP_TOKEN=""

# Who can create an account: closed | invite | open. Default invite. An admin
# can change it in the console without a redeploy.
# REGISTRATION="invite"

# Days a sign-in lasts without being used (sliding). Default 30.
# SESSION_TTL_DAYS="30"

# Days the audit log is kept. Default 365.
# AUDIT_RETENTION_DAYS="365"

# --- Nudges -----------------------------------------------------------------

# Web Push keys. Leave unset and a pair is generated on first use and kept in
# the database, which is fine; set them to manage the keys yourself
# (npx web-push generate-vapid-keys). Changing them orphans every subscription.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# Who push services contact about this sender: mailto: or https:. Default: an
# https APP_URL, else the first admin's email.
# VAPID_SUBJECT=""

# Whether this process runs the nudge scheduler and housekeeping. Default on
# in production. Safe on several replicas either way (jobs take a lease).
# SCHEDULER="on"

# --- Operations -------------------------------------------------------------

# debug | info | warn | error. JSON lines on stdout.
# LOG_LEVEL="info"

# Enables /api/internal/metrics (Prometheus) for Authorization: Bearer <this>.
# Unset, the endpoint does not exist.
# METRICS_TOKEN=""

# WAL (default) needs shared memory beside the database file, which network
# filesystems do not give. Set DELETE if /data is an NFS or SMB mount.
# SQLITE_JOURNAL_MODE="WAL"

# --- Voice entry ------------------------------------------------------------

# Optional: a key everyone without their own can use. An admin can also set a
# shared key in the console; people can paste their own in Settings.
# OPENROUTER_API_KEY=""
