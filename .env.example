# Names the Compose project. Container, network and the managed volume are all
# prefixed with it, so giving each instance its own name is what lets several
# run side by side on one machine. Defaults to the directory name.
# COMPOSE_PROJECT_NAME="snackexercise-tracker"

# Host port the app is published on. The container always listens on 3000.
# Two instances cannot publish the same one.
APP_PORT="3000"

# Where the database is mounted from. A whole mount spec, source:target — the
# target must stay /data. Unset means the managed volume `snackexercise-data`.
# A host path works as-is; any other named volume must also be declared in the
# top-level `volumes:` block of docker-compose.yml.
# APP_VOLUMES="/srv/snackexercise:/data"

# Local SQLite database file. In Docker this points at the mounted volume.
DATABASE_URL="file:./dev.db"

# Timezone used to bucket entries into local days. Set to your own zone.
TZ="Europe/Berlin"

# Optional: seeds the OpenRouter key on first run. You can also paste it in Settings.
# OPENROUTER_API_KEY=""
